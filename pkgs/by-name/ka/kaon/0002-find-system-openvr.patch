+add_library(openvr_api SHARED IMPORTED)
+set_property(TARGET openvr_api PROPERTY IMPORTED_LOCATION ${OPENVR_LIBRARIES})
+target_include_directories(openvr_api INTERFACE ${OPENVR_INCLUDE_DIR})
 endif()
 
 add_subdirectory(src)
